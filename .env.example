# === Telegram Settings ===
TELEGRAM_BOT_TOKEN=your_token_here
ADMIN_USER_ID=123456789

# === AI API (Основной канал / OpenAI Compatible) ===
# Сюда можно вставить ключ от OpenRouter, Mistral, DeepSeek или OpenAI.
AI_API_KEY=sk-or-v1-your_key_here

# Адрес API (Base URL). 
# Если не указан, по умолчанию используется OpenRouter: https://openrouter.ai/api/v1
# Для Mistral: https://api.mistral.ai/v1
# Для LocalAI/Ollama: http://localhost:11434/v1
# AI_BASE_URL=https://api.mistral.ai/v1

# === Search Engine (Поиск / RAG) ===
# Выбор провайдера: tavily | perplexity | google
# tavily - лучший для RAG (1000 бесплатных запросов).
# perplexity - использует модель Sonar (платно через OpenRouter).
# google - использует нативный поиск Gemini (бесплатно, но нужны ключи Google).
SEARCH_PROVIDER=tavily

# Ключ Tavily (если выбран SEARCH_PROVIDER=tavily)
TAVILY_API_KEY=tvly-your_key_here

# === Google Gemini (Native Fallback) ===
# Используется, если Основной API недоступен, или для экономии,
# а также для мультимодальной работы с PDF, изображениями, аудио и видео.
# DOCX/PPTX/XLSX извлекаются локально и затем передаются основной модели текстом.
GOOGLE_GEMINI_API_KEY=your_google_key_1
GOOGLE_GEMINI_API_KEY_2=your_google_key_2

# Резерв распознавания при перегрузке основной модели. Общий лимит: 60 секунд.
VOICE_FALLBACK_MODEL=gemini-2.5-flash
# Общий лимит генерации и проверки краткого пересказа.
VOICE_SUMMARY_TIMEOUT_SECONDS=45

# === Надёжность хранилища (необязательно) ===
# Резервный снимок при запуске и затем с указанным интервалом.
BACKUP_INTERVAL_HOURS=24
# Сколько последних снимков хранить в data/backups.
BACKUP_RETENTION=14

# === Лимиты внешнего контента (необязательно) ===
# Жёсткий потолок. Фактический бюджет выбирается по запросу: 6k обзор, 12k пересказ,
# 25k подробный разбор, весь потолок — только для явно полного/дословного запроса.
YOUTUBE_TRANSCRIPT_MAX_CHARS=100000
# Если субтитры недоступны, Gemini анализирует публичный YouTube-ролик напрямую.
YOUTUBE_GEMINI_MODEL=gemini-3.5-flash-lite
YOUTUBE_GEMINI_TIMEOUT_SECONDS=45
# Повторный одинаковый запрос не анализирует длинное видео заново в течение этого срока.
YOUTUBE_GEMINI_CACHE_HOURS=6
OFFICE_TEXT_MAX_CHARS=100000
# Максимальный суммарный размер нужных XML после распаковки Office-файла.
OFFICE_EXPANDED_MAX_MB=32

# === Спонтанная активность в чате ===
# Шанс влезть в разговор самому, без обращения по имени (0.05 = 5% подходящих сообщений).
SPONTANEOUS_CHANCE=0.05
# Минимальная пауза между спонтанными репликами в одном чате, минуты.
SPONTANEOUS_COOLDOWN_MIN=15
# Потолок длины спонтанной реплики, символы.
SPONTANEOUS_MAX_CHARS=300
# Шанс одиночной эмодзи-реакции на чужое сообщение.
REACTION_CHANCE=0.015
